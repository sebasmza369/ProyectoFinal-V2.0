---
import Layout from '../../layouts/Layout.astro';

// 1. Obtenemos el ID de la URL
const { id } = Astro.params;

// 2. Consultamos nuestra API Backend[cite: 1]
const response = await fetch(`http://localhost:3000/api/v1/libros/${id}`);

// 3. Si el libro no existe en la BD (error 404), redirigimos a /404
if (!response.ok) {
  return Astro.redirect('/404');
}

// 4. Extraemos el objeto libro en JSON[cite: 1]
const libro = await response.json();
---

<Layout title={libro.titulo}>
  <div style="background-color: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; margin-top: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
    
    <!-- 📖 MODO LECTURA (Visible por defecto) -->
    <div id="vista-lectura">
      <a href="/catalogo" style="color: var(--color-primary); text-decoration: none; font-weight: 500; display: inline-block; margin-bottom: 1rem;">
        ← Volver al catálogo
      </a>
      
      <h1 style="font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem; color: var(--color-text-main);">
        {libro.titulo}
      </h1>
      
      <p style="color: var(--color-text-muted); font-weight: 600; margin-bottom: 0.5rem;">
        Autor: {libro.autor}
      </p>

      <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">
        Género: {libro.genero}
      </p>

      <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
        Año de publicación: {libro.anio_publicacion || 'No especificado'}
      </p>
      
      <hr style="border: 0; border-top: 1px solid var(--color-border); margin-bottom: 1.5rem;" />

      <div style="line-height: 1.6; color: var(--color-text-main); margin-bottom: 2rem;">
        <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">Sinopsis</h2>
        <p>{libro.sinopsis ? libro.sinopsis : 'Sin descripción disponible.'}</p>
      </div>

      <!-- Botón para activar el modo edición -->
      <button 
        id="btn-activar-edicion" 
        style="background-color: var(--color-primary); color: white; border: none; padding: 0.6rem 1.2rem; border-radius: 6px; cursor: pointer; font-weight: 500;"
      >
        ✏️ Editar Libro
      </button>
    </div>

    <!-- ✏️ MODO EDICIÓN EN LÍNEA (Oculto por defecto) -->
    <div id="vista-edicion" style="display: none;">
      <h2 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 1.5rem; color: var(--color-text-main);">
        ✏️ Modificar Libro
      </h2>

      <form id="form-editar-inline" data-id={id} style="display: flex; flex-direction: column; gap: 1rem;">
        <!-- Título -->
        <div>
          <label for="input-titulo" style="display: block; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.4rem;">Título *</label>
          <input 
            type="text" 
            id="input-titulo" 
            name="titulo" 
            value={libro.titulo} 
            required 
            style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 6px; box-sizing: border-box;"
          />
        </div>

        <!-- Autor -->
        <div>
          <label for="input-autor" style="display: block; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.4rem;">Autor *</label>
          <input 
            type="text" 
            id="input-autor" 
            name="autor" 
            value={libro.autor} 
            required 
            style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 6px; box-sizing: border-box;"
          />
        </div>

        <!-- Género -->
        <div>
          <label for="input-genero" style="display: block; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.4rem;">Género *</label>
          <input 
            type="text" 
            id="input-genero" 
            name="genero" 
            value={libro.genero} 
            required 
            style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 6px; box-sizing: border-box;"
          />
        </div>

        <!-- Año de publicación -->
        <div>
          <label for="input-anio" style="display: block; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.4rem;">Año de Publicación</label>
          <input 
            type="number" 
            id="input-anio" 
            name="anio_publicacion" 
            value={libro.anio_publicacion} 
            style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 6px; box-sizing: border-box;"
          />
        </div>

        <!-- Sinopsis -->
        <div>
          <label for="input-sinopsis" style="display: block; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.4rem;">Sinopsis</label>
          <textarea 
            id="input-sinopsis" 
            name="sinopsis" 
            rows="4" 
            style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 6px; box-sizing: border-box;"
          >{libro.sinopsis}</textarea>
        </div>

        <!-- Botones de Guardar / Cancelar -->
        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
          <button 
            type="submit" 
            style="background-color: var(--color-primary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 6px; cursor: pointer; font-weight: bold;"
          >
            💾 Guardar Cambios
          </button>

          <button 
            type="button" 
            id="btn-cancelar-edicion" 
            style="background-color: var(--color-border); color: var(--color-text-main); border: none; padding: 0.75rem 1.5rem; border-radius: 6px; cursor: pointer; font-weight: 500;"
          >
            ❌ Cancelar
          </button>
        </div>
      </form>
    </div>

  </div>

  <!-- ⚡ SCRIPT PARA LA ALTERNANCIA Y ENVÍO DE DATOS -->
  <script>
    const vistaLectura = document.getElementById('vista-lectura');
    const vistaEdicion = document.getElementById('vista-edicion');
    
    const btnActivar = document.getElementById('btn-activar-edicion');
    const btnCancelar = document.getElementById('btn-cancelar-edicion');
    const form = document.getElementById('form-editar-inline');

    // 1. Mostrar formulario de edición
    btnActivar?.addEventListener('click', () => {
      if (vistaLectura && vistaEdicion) {
        vistaLectura.style.display = 'none';
        vistaEdicion.style.display = 'block';
      }
    });

    // 2. Ocultar formulario de edición (Cancelar)
    btnCancelar?.addEventListener('click', () => {
      if (vistaLectura && vistaEdicion) {
        vistaEdicion.style.display = 'none';
        vistaLectura.style.display = 'block';
      }
    });

    // 3. Enviar cambios al backend con PUT
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const id = form.getAttribute('data-id');
      const formData = new FormData(form as HTMLFormElement);

      const libroActualizado = {
        titulo: formData.get('titulo'),
        autor: formData.get('autor'),
        genero: formData.get('genero'),
        anio_publicacion: formData.get('anio_publicacion') ? Number(formData.get('anio_publicacion')) : null,
        sinopsis: formData.get('sinopsis')
      };

      try {
        const respuesta = await fetch(`http://localhost:3000/api/v1/libros/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(libroActualizado)
        });

        if (respuesta.ok) {
          alert('¡Libro actualizado con éxito! ✨');
          window.location.reload();
        } else {
          const error = await respuesta.json();
          alert(`Error: ${error.mensaje || 'No se pudo actualizar el libro'}`);
        }
      } catch (error) {
        console.error('Error de red:', error);
        alert('Ocurrió un error al conectar con el servidor.');
      }
    });
  </script>
</Layout>